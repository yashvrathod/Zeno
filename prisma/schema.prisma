// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  avatar        String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profile fields
  bio         String?
  location    String?
  websiteUrl  String?
  linkedinUrl String?
  githubUrl   String?

  // Arrays stored as JSON for portability.
  // Example: ["Java", "Python"]
  languages Json?
  // Example: ["Dynamic Programming", "Hash Table"]
  skills    Json?
  // Example: ["line 1", "line 2"]
  quote     Json?

  accounts Account[]
  sessions Session[]

  aiSettings   UserAiSettings?
  problemStats UserProblemStats[]
  
  // Social features
  posts         Post[]
  postLikes     PostLike[]
  comments      Comment[]
  followers     Follow[]   @relation("Following")
  following     Follow[]   @relation("Follower")
  channelFollows ChannelFollow[]
}

model UserAiSettings {
  id        String   @id @default(cuid())
  userId    String   @unique

  // How verbose the mentor should be.
  verbosity String   @default("normal") // 'short' | 'normal' | 'detailed'

  // Free-form user preferences kept small (e.g., "use bullet points", "avoid spoilers").
  preferencesJson Json?

  // User's own API keys (encrypted/hashed in production)
  groqApiKey       String? // User's Groq API key
  openaiApiKey     String? // User's OpenAI API key
  googleApiKey     String? // User's Google AI Studio API key
  openrouterApiKey String? // User's OpenRouter API key
  ollamaBaseUrl    String? // User's Ollama server URL (e.g., http://localhost:11434)
  ollamaModel      String? // User's preferred Ollama model (e.g., llama3.1, codellama)
  apiProvider      String? @default("server") // 'server' | 'groq' | 'openai' | 'google' | 'openrouter' | 'ollama'
  hasCompletedOnboarding Boolean @default(false) // Track if user has seen API setup

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProblemStats {
  id        String   @id @default(cuid())
  userId    String
  problemId String

  // Aggregated counters (bounded: one row per user+problem)
  runCount         Int @default(0)
  submitCount      Int @default(0)
  acceptedCount    Int @default(0)
  wrongAnswerCount Int @default(0)
  runtimeErrorCount Int @default(0)

  lastStatus String?
  lastError  String?
  lastAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([problemId, updatedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Pattern {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems ProblemPattern[]
}

model Problem {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  statementMd   String
  constraintsMd String?
  difficulty    Difficulty @default(EASY)
  isPublished   Boolean    @default(false)

  // Optional: for listing/search
  tags Json?

  // Language -> starter code map, e.g. {"javascript":"...","python":"..."}
  starterCode Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patterns  ProblemPattern[]
  hints     Hint[]
  testCases TestCase[]
}

model ProblemPattern {
  problemId String
  patternId String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@id([problemId, patternId])
}

model Hint {
  id        String @id @default(cuid())
  problemId String
  order     Int
  textMd    String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, order])
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  order     Int
  input     String
  expected  String
  isHidden  Boolean @default(false)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, order, isHidden])
  @@index([problemId])
}

model MentorInteractionLog {
  id             String   @id @default(cuid())
  userId         String
  problemId      String
  eventType      String
  mentorQuestion String
  createdAt      DateTime @default(now())

  @@index([userId, problemId, createdAt])
  @@index([problemId, createdAt])
}

// Raw conversation transcript per user+problem.
// This is temporary: archived into MentorConversationSummary on solve or manual finish.
model MentorConversationMessage {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  role      String   // 'user' | 'assistant' | 'system'
  content   String
  metadata  Json?    // Stores { rung, stage, tone } for tracking progression
  createdAt DateTime @default(now())

  @@index([userId, problemId, createdAt])
  @@index([problemId, createdAt])
}

// Archived learning summary after solve/finish.
model MentorConversationSummary {
  id              String   @id @default(cuid())
  userId          String
  problemId       String
  status          String   // 'SOLVED' | 'FINISHED' | 'ONGOING'
  solvedAt        DateTime?
  summaryMd       String
  approachNotesMd String?
  pitfallsMd      String?
  keyInsightsMd   String?
  messageCount    Int      @default(0)
  lastRung        Int      @default(1)
  breakthroughs   String[] // patterns the student has mastered
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, problemId])
  @@index([problemId, updatedAt])
}

// Social Feed Posts
model Post {
  id          String   @id @default(cuid())
  userId      String
  content     String
  codeSnippet String?
  language    String?  // programming language if code snippet exists
  imageUrl    String?
  tags        String[] // hashtags
  likeCount   Int      @default(0)
  commentCount Int     @default(0)
  shareCount  Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       PostLike[]
  comments    Comment[]

  @@index([userId, createdAt])
  @@index([featured, createdAt])
  @@index([createdAt])
}

// Post Likes
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

// Comments on Posts
model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

// User Following System
model Follow {
  id          String   @id @default(cuid())
  followerId  String   // user who is following
  followingId String   // user being followed
  createdAt   DateTime @default(now())

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// Channel Following
model ChannelFollow {
  id        String   @id @default(cuid())
  userId    String
  channelId String   // channel name/identifier (e.g., "vscode", "react")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
}

// Trending Topics Tracking
model TrendingTopic {
  id        String   @id @default(cuid())
  tag       String   @unique
  postCount Int      @default(1)
  weekCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([postCount])
  @@index([weekCount])
}
