generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  username           String?            @unique
  email              String             @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  avatar             String?
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  currentStreak      Int                @default(0)
  longestStreak      Int                @default(0)
  lastSolvedDate     DateTime?
  totalSolved        Int                @default(0)
  interviewReadiness Int                @default(0)
  bio                String?
  location           String?
  websiteUrl         String?
  linkedinUrl        String?
  githubUrl          String?
  languages          Json?
  skills             Json?
  quote              Json?
  accounts           Account[]
  channelFollows     ChannelFollow[]
  comments           Comment[]
  following          Follow[]           @relation("Follower")
  followers          Follow[]           @relation("Following")
  posts              Post[]
  postLikes          PostLike[]
  sessions           Session[]
  StudentProfile     StudentProfile?
  Subscription       Subscription?
  aiSettings         UserAiSettings?
  problemStats       UserProblemStats[]
}

model UserAiSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique

  // 🔥 Core settings
  apiProvider            String?  @default("server")
  verbosity              String   @default("normal")
  preferredFreeModel     String?  @default("nvidia/nemotron-3-nano-30b-a3b:free")

  // 🔑 API Keys (BYOK)
  groqApiKey             String?
  openaiApiKey           String?   
  googleApiKey           String?   
  openrouterApiKey       String?   

  // 🧠 Local LLM (Ollama)
  ollamaBaseUrl          String?   
  ollamaModel            String?   

  // 📦 Extra config
  groqModel              String?
  preferencesJson        Json?
  hasCompletedOnboarding Boolean  @default(false)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProblemStats {
  id                String    @id @default(cuid())
  userId            String
  problemId         String
  runCount          Int       @default(0)
  submitCount       Int       @default(0)
  acceptedCount     Int       @default(0)
  wrongAnswerCount  Int       @default(0)
  runtimeErrorCount Int       @default(0)
  firstAttemptAt    DateTime?
  solvedAt          DateTime?
  timeSpentSeconds  Int       @default(0)
  hintsUsed         Int       @default(0)
  escalationReached Int       @default(1)
  lastStatus        String?
  lastError         String?
  lastAt            DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  Problem           Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([problemId, updatedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Pattern {
  id                                                              String                @id @default(cuid())
  name                                                            String                @unique
  description                                                     String?
  createdAt                                                       DateTime              @default(now())
  updatedAt                                                       DateTime              @updatedAt
  PatternPrerequisite_PatternPrerequisite_patternIdToPattern      PatternPrerequisite[] @relation("PatternPrerequisite_patternIdToPattern")
  PatternPrerequisite_PatternPrerequisite_prerequisiteIdToPattern PatternPrerequisite[] @relation("PatternPrerequisite_prerequisiteIdToPattern")
  problems                                                        ProblemPattern[]
}

model Problem {
  id               String             @id @default(cuid())
  slug             String             @unique
  title            String
  statementMd      String
  constraintsMd    String?
  difficulty       Difficulty         @default(EASY)
  isPublished      Boolean            @default(false)
  orderInPattern   Int?
  isFree           Boolean            @default(false)
  expectedTimeMin  Int?
  tags             Json?
  starterCode      Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  hints            Hint[]
  patterns         ProblemPattern[]
  testCases        TestCase[]
  UserProblemStats UserProblemStats[]
}

model ProblemPattern {
  problemId String
  patternId String
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([problemId, patternId])
}

model Hint {
  id              String  @id @default(cuid())
  problemId       String
  order           Int
  textMd          String
  hintType        String  @default("constraint")
  escalationLevel Int     @default(1)
  problem         Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, order])
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  order     Int
  input     String
  expected  String
  isHidden  Boolean @default(false)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, order, isHidden])
  @@index([problemId])
}

model MentorInteractionLog {
  id             String   @id @default(cuid())
  userId         String
  problemId      String
  eventType      String
  mentorQuestion String
  createdAt      DateTime @default(now())

  @@index([userId, problemId, createdAt])
  @@index([problemId, createdAt])
}

model MentorConversationMessage {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, problemId, createdAt])
  @@index([problemId, createdAt])
}

model MentorConversationSummary {
  id              String    @id @default(cuid())
  userId          String
  problemId       String
  status          String
  solvedAt        DateTime?
  summaryMd       String
  approachNotesMd String?
  pitfallsMd      String?
  keyInsightsMd   String?
  messageCount    Int       @default(0)
  lastRung        Int       @default(1)
  breakthroughs   String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, problemId])
  @@index([problemId, updatedAt])
}

model Post {
  id           String     @id @default(cuid())
  userId       String
  content      String
  codeSnippet  String?
  language     String?
  imageUrl     String?
  tags         String[]
  likeCount    Int        @default(0)
  commentCount Int        @default(0)
  shareCount   Int        @default(0)
  featured     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  comments     Comment[]
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes        PostLike[]

  @@index([userId, createdAt])
  @@index([featured, createdAt])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ChannelFollow {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
}

model TrendingTopic {
  id        String   @id @default(cuid())
  tag       String   @unique
  postCount Int      @default(1)
  weekCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([postCount])
  @@index([weekCount])
}

model PatternPrerequisite {
  patternId                                           String
  prerequisiteId                                      String
  Pattern_PatternPrerequisite_patternIdToPattern      Pattern @relation("PatternPrerequisite_patternIdToPattern", fields: [patternId], references: [id])
  Pattern_PatternPrerequisite_prerequisiteIdToPattern Pattern @relation("PatternPrerequisite_prerequisiteIdToPattern", fields: [prerequisiteId], references: [id])

  @@id([patternId, prerequisiteId])
}

model StudentProfile {
  id                String    @id
  userId            String    @unique
  learningStyle     String?
  peakHour          Int?
  avgTimePerProblem Int       @default(0)
  giveUpRate        Float     @default(0)
  hintDependency    Float     @default(0)
  weakPatterns      Json?
  strongPatterns    Json?
  targetCompany     String?
  placementGoalDate DateTime?
  hasBeenPlaced     Boolean   @default(false)
  placedAt          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  User              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String    @id
  userId             String    @unique
  plan               String    @default("free")
  status             String    @default("active")
  razorpaySubId      String?
  razorpayCustomerId String?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  User               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CacheEntry {
  id           String    @id @default(cuid())
  problemId    String
  questionMd5  String
  embedding    Json
  response     String
  stage        String
  rung         Int
  usedCount    Int       @default(0)
  similarity   Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([problemId, questionMd5])
  @@index([problemId])
  @@index([usedCount])
}

model MentorSession {
  id             String          @id @default(cuid())
  userId         String
  problemId      String
  stage          String          @default("EXPLORE")
  currentRung    Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       MentorMessage[]

  @@unique([userId, problemId])
  @@index([userId])
  @@index([updatedAt])
}

model MentorMessage {
  id          String         @id @default(cuid())
  sessionId   String
  role        String
  content     String
  stage       String
  createdAt   DateTime       @default(now())
  session     MentorSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
